# Copy this file to .env and fill in your values
# cp .env.example .env

# ===== Profi.ru =====
PROFI_DOMAIN=tomsk.profi.ru        # your city subdomain, e.g. msk.profi.ru

# ===== OpenRouter AI =====
OPENROUTER_KEY=your_openrouter_api_key_here
AI_MODEL=baidu/cobuddy:free        # any OpenRouter model, free or paid

# ===== Your messages (max 500 chars each) =====
ARABIC_MESSAGE=Здравствуйте! Меня зовут ..., я носитель арабского языка ...
ENGLISH_MESSAGE=Здравствуйте! Меня зовут ..., я преподаю английский онлайн ...

# ===== Bot settings =====
CHECK_INTERVAL=60                  # seconds between board scans
DEFAULT_PRICE_ENGLISH=1000         # default price ₽/hr for English orders
DEFAULT_PRICE_ARABIC=1500          # default price ₽/hr for Arabic orders
